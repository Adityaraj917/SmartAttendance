{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "expo-camera": [
        "./node_modules/expo-camera"
      ]
    },
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  }
}