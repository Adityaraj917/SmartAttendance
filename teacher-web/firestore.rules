rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
    }

    match /classrooms/{classroomId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Teachers
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      // Device Binding & Connection Tracking
      match /connectedStudents/{studentId} {
        allow read: if isAuthenticated();
        // Allow creating connection (Join)
        allow create: if request.auth.uid == studentId;
        // Allow update (Heartbeat) ONLY if deviceId remains same (Strict Device Binding)
        allow update: if request.auth.uid == studentId 
                      && request.resource.data.deviceId == resource.data.deviceId;
      }

      // Heartbeat Acks
      match /heartbeats/{studentId} {
         allow read: if isAuthenticated();
         allow write: if request.auth.uid == studentId;
      }
    }

    match /attendance/{recordId} {
      allow read: if isAuthenticated();
      // Strict Attendance:
      // 1. Must be the user
      // 2. Must already be "Connected" to the session (exists in subcollection)
      allow create: if isAuthenticated() 
                    && request.resource.data.studentId == request.auth.uid
                    && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)/connectedStudents/$(request.auth.uid));
      allow update: if false; // Immutable log
    }
  }
}
